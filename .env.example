# ============================================================================
# VARIABLES DE ENTORNO - InventarioFoto PWA
# ============================================================================

# Copia este archivo a .env y completa los valores
# NO commits .env a GitHub (solo .env.example)

# ============================================================================
# REQUERIDO PARA ANÁLISIS DE IMÁGENES CON IA
# ============================================================================

# API Key de Google Gemini para análisis de imágenes
# Obtén la tuya en: https://makersuite.google.com/app/apikey
# Si no lo configureas, la app funciona sin análisis automático
GEMINI_API_KEY=

# ============================================================================
# OPCIONAL - Configuración del Servidor
# ============================================================================

# Puerto en que se ejecuta la app (default: 5000)
PORT=5000

# Ambiente (development, testing, production)
FLASK_ENV=development

# Clave de acceso a la API (obligatoria si FLASK_ENV=production).
# Sin API_KEY en desarrollo la API queda abierta (solo local).
# API_KEY=cambia-esta-clave-larga

# Ruta para base de datos SQLite local (default: inventario.db)
SQLITE_PATH=inventario.db

# Base de datos Postgres (producción). Si se define, se usa en lugar de SQLite.
# En Render se configura automáticamente vía render.yaml.
# DATABASE_URL=postgresql://user:password@host/inventario

# Modo debug de Flask (NUNCA en producción)
# FLASK_DEBUG=1

# ============================================================================
# NOTAS DE SEGURIDAD
# ============================================================================

# ✅ HACER:
# - Mantén .env en .gitignore
# - Usa contraseñas y keys fuertes y únicas
# - En producción, configura variables desde el dashboard del hosting
# - Rota keys regularmente

# ❌ NO HACER:
# - No commitees .env a GitHub
# - No hardcodees secrets en el código
# - No compartas tus keys en issues o PRs
# - No uses keys de desarrollo en producción

# ============================================================================
# VARIABLES ALTERNATIVAS (Avanzado)
# ============================================================================

# Para usar PostgreSQL en lugar de SQLite (futura mejora)
# DATABASE_URL=postgresql://user:password@localhost/inventario

# Para logging avanzado
# LOG_LEVEL=DEBUG

# Para CORS (desarrollo remoto)
# ALLOWED_ORIGINS=http://localhost:3000,https://tudominio.com
